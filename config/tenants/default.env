# Tenant Template – Kopiere und passe Werte an
TENANT_ID=default
TENANT_NAME=Default Tenant

# Branding
BRAND_COLOR=#FF6600
BRAND_LOGO_URL=
WEBSITE_URL=https://example.com

# Kontakt
CONTACT_EMAIL=info@example.com
CONTACT_PHONE=+43 1 234 5678
COMPANY_NAME=Example GmbH
COMPANY_ADDRESS=Musterstraße 1, 1010 Wien

# Follow-up Konfiguration
FOLLOWUP_STEPS=5
FOLLOWUP_DELAY_DAYS=3,5,7,14,30
FOLLOWUP_ENABLED=true

# Scoring
SCORE_THRESHOLD_HOT=80
SCORE_THRESHOLD_WARM=40
SCORE_KONFIGURATOR_BONUS=30
SCORE_EMAIL_OPEN_BONUS=5

# Content-Strategie
CONTENT_PLATFORMS=linkedin,instagram
CONTENT_FREQUENCY_PER_WEEK=3
CONTENT_TONE=professional

# Ad Budgets
AD_MONTHLY_BUDGET=2000
AD_PLATFORMS=google,meta
