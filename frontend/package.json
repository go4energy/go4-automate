{
  "name": "go4-automate-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js --fix",
    "format": "prettier --write \"src/**/*.{vue,js,json}\"",
    "lint:check": "eslint . --ext .vue,.js && prettier --check \"src/**/*.{vue,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/theme-one-dark": "^6.1.3",
    "apexcharts": "^4.1.0",
    "axios": "^1.7.0",
    "codemirror": "^6.0.2",
    "marked": "^17.0.4",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-email-editor": "^2.2.0",
    "vue-router": "^4.5.0",
    "vue3-apexcharts": "^1.7.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^20.7.0",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
