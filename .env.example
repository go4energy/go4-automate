# go4-automate – Environment Variables
# Kopiere diese Datei nach backend/.env und passe die Werte an

# App
APP_NAME=go4-automate
APP_URL=https://automate.go4.energy
DEBUG=false
PLATFORM_NAME=go4-automate
DOMAIN=localhost
TIMEZONE=Europe/Vienna

# Database
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/go4automate

# Redis
REDIS_URL=redis://localhost:6379/0

# Security – MUSS geaendert werden!
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING
INITIAL_ADMIN_PASSWORD=changeme
ALLOWED_ORIGINS=["https://automate.go4.energy"]
BACKEND_SECRET=
LISTENER_SELF_REGISTRATION=true
JWT_EXPIRY_HOURS=720

# AI APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LLM Model Routing
LLM_MODEL_CONTENT=claude-sonnet-4-5-20250929
LLM_MODEL_ANALYSIS=gpt-4o-mini
LLM_MODEL_CLASSIFICATION=gpt-4o-mini
LLM_MODEL_SCORING=gpt-4o-mini

# LLM Briefing (switchable: "anthropic" | "ollama")
LLM_MODEL_BRIEFING=anthropic
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Meta (Facebook/Instagram)
META_SYSTEM_USER_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_BUSINESS_ID=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_API_VERSION=v21.0

# Microsoft 365 OAuth (Briefing: Kalender/E-Mail)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Google OAuth (Briefing: Kalender/E-Mail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# n8n
N8N_URL=http://localhost:5678
N8N_API_KEY=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@go4.energy

# Websuche
SERPER_API_KEY=

# Wetter
OPENWEATHER_API_KEY=

# TTS ("piper" | "xtts" | "disabled")
TTS_ENGINE=piper
TTS_URL=http://localhost:10200
XTTS_URL=http://localhost:8020
SPEAKER_UPLOAD_DIR=uploads/speakers
BRIEFING_AUDIO_DIR=uploads/briefing

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Tenant
DEFAULT_TENANT_ID=default
ACTIVE_TENANT=go4energy
TENANT_CONFIG_DIR=config/tenants
TEMPLATE_DIR=config/templates

# Frontend (used during build)
VITE_API_URL=/api
