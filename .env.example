# go4-automate – Environment Variables
# Kopiere diese Datei nach config/.env und passe die Werte an

# App
APP_NAME=go4-automate
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/go4automate
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING
ALLOWED_ORIGINS=["https://yourdomain.com"]

# AI APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# n8n
N8N_URL=http://n8n:5678
N8N_API_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@go4.energy

# Tenant
DEFAULT_TENANT_ID=default

# Frontend (used during build)
VITE_API_URL=/api
